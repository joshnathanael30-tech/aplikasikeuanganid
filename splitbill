window.toggleFriend = function(username) {
  const uLow = String(username || '').toLowerCase();
  if (!uLow) return;
  if (S.selectedFriends[uLow]) {
    delete S.selectedFriends[uLow];
  } else {
    const f = S.friends.find(x => String(x.friendUsername || '').toLowerCase() === uLow);
    if (!f) return;
    S.selectedFriends[uLow] = {
      username: f.friendUsername,
      namaLengkap: f.friendNamaLengkap || f.friendUsername,
      amount: 0
    };
  }
  renderFriendsPicker();
  renderSelectedFriendInputs();
  recalcSummary();
};

function renderSelectedFriendInputs() {
  const wrap = document.getElementById('selected-friends-inputs');
  if (!wrap) return;
  const keys = Object.keys(S.selectedFriends);
  if (!keys.length) {
    wrap.innerHTML = '<p class="text-[11px] font-semibold text-zinc-400 text-center py-2">Pilih teman di atas untuk mengisi bagian tagihan mereka.</p>';
    return;
  }

  wrap.innerHTML = keys.map(k => {
    const item = S.selectedFriends[k];
    const safeName = String(item.namaLengkap || item.username).replace(/</g, '&lt;').replace(/>/g, '&gt;');
    const safeU = String(item.username).replace(/'/g, "\\'");
    const val = item.amount > 0 ? item.amount : '';
    return `
      <div class="p-2.5 rounded-xl bg-zinc-50 border border-zinc-200 flex items-center justify-between gap-2">
        <div class="min-w-0 flex-1">
          <p class="text-xs font-black text-zinc-900 truncate">${safeName}</p>
          <p class="text-[10px] font-bold text-zinc-400 truncate">@${item.username}</p>
        </div>
        <div class="relative w-36 flex-shrink-0">
          <span class="absolute left-3 top-1/2 -translate-y-1/2 text-[11px] font-bold text-zinc-400">Rp</span>
          <input type="number" min="1" placeholder="0" value="${val}"
            oninput="onFriendAmountInput('${safeU}', this.value)"
            class="mono-input !bg-white !py-2 !pl-8 !pr-2.5 text-right text-xs font-black border border-zinc-200">
        </div>
        <button type="button" onclick="toggleFriend('${safeU}')" class="w-7 h-7 rounded-lg bg-white border border-zinc-200 text-zinc-500 text-xs font-black flex-shrink-0">✕</button>
      </div>
    `;
  }).join('');
}

window.onFriendAmountInput = function(username, val) {
  const uLow = String(username || '').toLowerCase();
  if (!S.selectedFriends[uLow]) return;
  S.selectedFriends[uLow].amount = Math.max(0, Math.round(Number(val) || 0));
  recalcSummary();
};

window.onTotalOrOwnInput = function(source) {
  const total = Math.max(0, Math.round(Number(document.getElementById('sb-total-amount')?.value) || 0));
  const own   = Math.max(0, Math.round(Number(document.getElementById('sb-own-amount')?.value) || 0));
  const keys  = Object.keys(S.selectedFriends);
  if (keys.length === 1 && total > 0 && own <= total && source === 'own') {
    S.selectedFriends[keys[0]].amount = Math.max(0, total - own);
    renderSelectedFriendInputs();
  }
  recalcSummary();
};

window.divideEquallyAll = function() {
  const total = Math.max(0, Math.round(Number(document.getElementById('sb-total-amount')?.value) || 0));
  const keys  = Object.keys(S.selectedFriends);
  const n     = 1 + keys.length;
  if (total <= 0 || !keys.length) return;
  const each = Math.floor(total / n);
  const rem  = total - (each * n);
  document.getElementById('sb-own-amount').value = String(each + rem);
  keys.forEach(k => { S.selectedFriends[k].amount = each; });
  renderSelectedFriendInputs();
  recalcSummary();
};

window.divideRemainderFriends = function() {
  const total = Math.max(0, Math.round(Number(document.getElementById('sb-total-amount')?.value) || 0));
  const own   = Math.max(0, Math.round(Number(document.getElementById('sb-own-amount')?.value) || 0));
  const keys  = Object.keys(S.selectedFriends);
  if (total <= 0 || !keys.length) return;
  const rem  = Math.max(0, total - own);
  const each = Math.floor(rem / keys.length);
  const left = rem - (each * keys.length);
  keys.forEach((k, i) => { S.selectedFriends[k].amount = each + (i === 0 ? left : 0); });
  renderSelectedFriendInputs();
  recalcSummary();
};

function recalcSummary() {
  const total = Math.max(0, Math.round(Number(document.getElementById('sb-total-amount')?.value) || 0));
  const own   = Math.max(0, Math.round(Number(document.getElementById('sb-own-amount')?.value) || 0));
  const keys  = Object.keys(S.selectedFriends);
  let sumFriends = 0;
  keys.forEach(k => { sumFriends += (Number(S.selectedFriends[k].amount) || 0); });

  document.getElementById('sum-total').textContent   = idr(total);
  document.getElementById('sum-own').textContent     = idr(own);
  document.getElementById('sum-friends').textContent = idr(sumFriends);

  const stEl = document.getElementById('sum-status');
  const diff = total - (own + sumFriends);
  if (total <= 0) {
    stEl.textContent = 'Isi nominal';
    stEl.className = 'font-black text-zinc-400';
  } else if (!keys.length) {
    stEl.textContent = 'Pilih teman';
    stEl.className = 'font-black text-zinc-500';
  } else if (diff === 0) {
    stEl.textContent = '✓ Sesuai Total';
    stEl.className = 'font-black text-zinc-900';
  } else if (diff > 0) {
    stEl.textContent = `Kurang ${idr(diff)}`;
    stEl.className = 'font-black text-zinc-600';
  } else {
    stEl.textContent = `Lebih ${idr(Math.abs(diff))}`;
    stEl.className = 'font-black text-zinc-600';
  }
}

window.handleCreateSplitBill = async function(e) {
  e.preventDefault();
  const errEl = document.getElementById('form-err');
  errEl.classList.add('hidden');

  const title    = String(document.getElementById('sb-title')?.value || '').trim();
  const category = String(document.getElementById('sb-category')?.value || 'Makanan & Minuman').trim();
  const dompetId = String(document.getElementById('sb-dompet')?.value || '').trim();
  const total    = Math.round(Number(document.getElementById('sb-total-amount')?.value) || 0);
  const own      = Math.round(Number(document.getElementById('sb-own-amount')?.value) || 0);
  const keys     = Object.keys(S.selectedFriends);

  if (!keys.length) {
    errEl.textContent = 'Pilih minimal 1 teman.';
    errEl.classList.remove('hidden');
    return;
  }

  const participants = [];
  let sumFriends = 0;
  for (let i = 0; i < keys.length; i++) {
    const it = S.selectedFriends[keys[i]];
    const amt = Math.round(Number(it.amount) || 0);
    if (amt <= 0) {
      errEl.textContent = `Bagian @${it.username} harus lebih dari Rp 0.`;
      errEl.classList.remove('hidden');
      return;
    }
    sumFriends += amt;
    participants.push({
      username: it.username,
      namaLengkap: it.namaLengkap,
      amount: amt
    });
  }

  if (total <= 0 || Math.abs((own + sumFriends) - total) > 1) {
    errEl.textContent = `Bagian kita + teman (${idr(own + sumFriends)}) harus sama dengan Total (${idr(total)}).`;
    errEl.classList.remove('hidden');
    return;
  }

  const chosenDompet = S.dompetList.find(d => String(d.id) === String(dompetId)) || S.dompetList[0] || null;
  if (chosenDompet) {
    const avail = hitungSaldoDompet(chosenDompet.id);
    if (total > avail) {
      errEl.textContent = `Saldo dompet tidak cukup (${idr(avail)}).`;
      errEl.classList.remove('hidden');
      return;
    }
  }

  const btn = document.getElementById('btn-submit-sb');
  btn.disabled = true;
  btn.textContent = 'Mengirim Split Bill…';

  const creatorTxId = 'sb_init_' + Date.now();
  const friendTags  = participants.map(p => '@' + p.username).join(', ');

  // 1. Potong saldo pembuat terlebih dahulu
  const creatorOutTx = {
    id: creatorTxId,
    'Kategori': 'Uang Keluar',
    'Kategori Uang Keluar': category,
    'Jumlah Uang': total,
    'Tanggal': new Date().toISOString(),
    'Deskripsi': `Split Bill: ${title} (Bagian sendiri ${idr(own)}, patungan ${friendTags})`,
    'DompetId': chosenDompet ? chosenDompet.id : null
  };
  S.transactions.unshift(creatorOutTx);
  saveLocalTransactionsAndCache();
  postUserSheetData('addData', creatorOutTx);

  // 2. Simpan ke DATA MASTER SplitBills
  const res = await callMasterApi('createSplitBill', {
    title: title,
    category: category,
    creatorUsername: S.akun.username,
    creatorNamaLengkap: S.akun.namaLengkap || S.akun.username,
    creatorDompetId: chosenDompet ? chosenDompet.id : '',
    creatorDompetNama: chosenDompet ? (chosenDompet.nama || chosenDompet.provider) : 'Dompet Utama',
    totalAmount: total,
    creatorShareAmount: own,
    participants: participants,
    creatorTxId: creatorTxId
  });

  btn.disabled = false;
  btn.textContent = 'Kirim Split Bill';

  if (res && res.status === 'success' && res.data) {
    S.allBills.unshift(res.data);
    saveLocalTransactionsAndCache();
    document.getElementById('sb-form').reset();
    S.selectedFriends = {};
    renderFriendsPicker();
    renderSelectedFriendInputs();
    recalcSummary();
    populateDompetOptions('sb-dompet');
    showToast('Split Bill terkirim & saldo Anda telah dipotong.');
    // Langsung buka detail Split Bill yang baru dibuat (lengkap dengan opsi Chat langsung)
    switchMainTab('list');
    openDetailModal(res.data.id);
  } else {
    errEl.textContent = (res && res.message) || 'Gagal membuat Split Bill.';
    errEl.classList.remove('hidden');
  }
};

