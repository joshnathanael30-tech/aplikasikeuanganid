<script>
const GLOBAL_GS_URL = 'https://script.google.com/macros/s/AKfycbxC6ZbEz0GDuxLaqkNYQEQsO4-WLB5dnEPHBhqBjqovaAizmPqlCcxBvLWTHmcD5Jth/exec';
const AUTH_SESSION_KEY = 'keuangan_akun_session';
const TX_CACHE_KEY     = 'keuangan_transactions_cache';
const CAT_STORAGE_KEY  = 'keuangan_categories_v1';

const idr = n => new Intl.NumberFormat('id-ID', { style: 'currency', currency: 'IDR', minimumFractionDigits: 0 }).format(n || 0);

let S = {
  akun: null,
  gsUrl: '',
  transactions: [],
  dompetList: [],
  friends: [],
  allBills: [],
  incomingBills: [],
  selectedFriends: {}, // { uLow: { username, namaLengkap, amount } }
  mainTab: 'create',
  listFilter: 'all',
  activeBillId: null,
  inlineChatOpen: false,
  inlineChatTargetUsername: '',
  inlineChatMessages: {}, // { roomId: [msg, ...] }
  inlineChatTimer: null
};

// ── STORAGE HELPERS ──
function storageGet(key) {
  try {
    const v = localStorage.getItem(key);
    if (v !== null) return v;
  } catch (e) {}
  try {
    const m = document.cookie.match(new RegExp('(?:^|; )' + key.replace(/[.*+?^${}()|[\]\\]/g, '\\$&') + '=([^;]*)'));
    return m ? decodeURIComponent(m[1]) : null;
  } catch (e) { return null; }
}

function checkSession() {
  try {
    const raw = storageGet(AUTH_SESSION_KEY);
    if (!raw) return false;
    const parsed = JSON.parse(raw);
    if (parsed && parsed.username && parsed.gsUrl) {
      S.akun = parsed;
      S.gsUrl = parsed.gsUrl;
      return true;
    }
  } catch (e) {}
  return false;
}

function showToast(msg) {
  const box = document.getElementById('toast-box');
  const txt = document.getElementById('toast-text');
  if (!box || !txt) return;
  txt.textContent = msg;
  box.classList.remove('hidden');
  clearTimeout(window._toastTimer);
  window._toastTimer = setTimeout(() => box.classList.add('hidden'), 2600);
}

window.goBackHome = function(e) {
  if (e) e.preventDefault();
  try { window.top.location.href = 'https://keloladuit.my.id/home'; }
  catch (err) { window.location.href = 'https://keloladuit.my.id/home'; }
};

// ── LOAD LOCAL CACHES (DOMPET, TRANSAKSI, KATEGORI, INBOX) ──
function loadLocalData() {
  try {
    const txRaw = localStorage.getItem(TX_CACHE_KEY);
    if (txRaw) S.transactions = JSON.parse(txRaw) || [];
  } catch (e) {}

  try {
    const dptRaw = localStorage.getItem('keuangan_dompet_list');
    if (dptRaw) S.dompetList = JSON.parse(dptRaw) || [];
  } catch (e) {}

  if (S.akun && S.akun.username) {
    try {
      const inboxKey = 'keuangan_chat_inbox_v1_' + String(S.akun.username).toLowerCase();
      const inbRaw = localStorage.getItem(inboxKey);
      if (inbRaw) {
        const parsed = JSON.parse(inbRaw);
        if (parsed) {
          S.friends = Array.isArray(parsed.friends) ? parsed.friends : [];
          S.allBills = Array.isArray(parsed.splitBills) ? parsed.splitBills : [];
          S.incomingBills = Array.isArray(parsed.incomingSplitBills) ? parsed.incomingSplitBills : [];
        }
      }
    } catch (e) {}
  }
}

function saveLocalTransactionsAndCache() {
  try { localStorage.setItem(TX_CACHE_KEY, JSON.stringify(S.transactions)); } catch (e) {}
  if (S.akun && S.akun.username) {
    try {
      const inboxKey = 'keuangan_chat_inbox_v1_' + String(S.akun.username).toLowerCase();
      const existing = JSON.parse(localStorage.getItem(inboxKey) || '{}');
      existing.friends = S.friends;
      existing.splitBills = S.allBills;
      existing.incomingSplitBills = S.incomingBills;
      localStorage.setItem(inboxKey, JSON.stringify(existing));
    } catch (e) {}
  }
}

function hitungSaldoDompet(dompetId) {
  const d = S.dompetList.find(x => String(x.id) === String(dompetId));
  if (!d) return 0;
  let s = Number(d.saldoAwal) || 0;
  S.transactions.forEach(t => {
    if (String(t.DompetId) !== String(dompetId)) return;
    const v = Number(t['Jumlah Uang']) || 0;
    if (t.Kategori === 'Uang Masuk') s += v;
    if (t.Kategori === 'Uang Keluar') s -= v;
  });
  return s;
}

function populateDompetOptions(selectId) {
  const sel = document.getElementById(selectId);
  if (!sel) return;
  if (!S.dompetList.length) {
    sel.innerHTML = '<option value="">Dompet Utama / Tunai</option>';
    return;
  }
  sel.innerHTML = S.dompetList.map(d => {
    const s = hitungSaldoDompet(d.id);
    return `<option value="${d.id}">${d.nama || d.provider} (${idr(s)})</option>`;
  }).join('');
}

function populateCategories() {
  const sel = document.getElementById('sb-category');
  if (!sel) return;
  let cats = [
    'Makanan & Minuman', 'Transportasi', 'Hiburan & Langganan', 'Kebutuhan',
    'Tagihan Rutin', 'Pendidikan', 'Kesehatan', 'Lainnya'
  ];
  try {
    const scopedKey = S.akun ? `${CAT_STORAGE_KEY}_${String(S.akun.username).toLowerCase()}` : CAT_STORAGE_KEY;
    const raw = storageGet(scopedKey) || storageGet(CAT_STORAGE_KEY);
    if (raw) {
      const parsed = JSON.parse(raw);
      if (Array.isArray(parsed) && parsed.length) {
        cats = parsed.filter(c => c && c.type === 'Uang Keluar' && c.active !== false).map(c => c.name);
      }
    }
  } catch (e) {}
  sel.innerHTML = cats.map(c => `<option value="${c}">${c}</option>`).join('');
}

// ── API CALLER (POST DENGAN FALLBACK GET ANTI-302) ──
async function callMasterApi(action, dataObj) {
  try {
    const r = await fetch(GLOBAL_GS_URL, {
      method: 'POST',
      headers: { 'Content-Type': 'text/plain;charset=utf-8' },
      body: JSON.stringify({ action: action, data: dataObj })
    });
    const j = await r.json();
    if (j) return j;
  } catch (e) {}

  try {
    const qs = `?action=${encodeURIComponent(action)}&payload=${encodeURIComponent(JSON.stringify(dataObj))}&_t=${Date.now()}`;
    const r2 = await fetch(GLOBAL_GS_URL + qs);
    return await r2.json();
  } catch (e2) {
    return { status: 'error', message: 'Gagal terhubung ke server.' };
  }
}

async function postUserSheetData(action, dataObj) {
  if (!S.gsUrl) return null;
  try {
    const r = await fetch(S.gsUrl, {
      method: 'POST',
      headers: { 'Content-Type': 'text/plain' },
      body: JSON.stringify({ action: action, data: dataObj })
    });
    return await r.json();
  } catch (e) {
    return null;
  }
}

// ── SYNC SERVER DATA ──
async function syncSplitBillAndFriends() {
  if (!S.akun || !S.akun.username) return;
  try {
    const uname = encodeURIComponent(S.akun.username);
    const r = await fetch(`${GLOBAL_GS_URL}?action=getFriendsAndInbox&username=${uname}&_t=${Date.now()}`);
    const j = await r.json();
    if (j && j.status === 'success' && j.data) {
      S.friends = Array.isArray(j.data.friends) ? j.data.friends : [];
      if (Array.isArray(j.data.splitBills)) {
        S.allBills = j.data.splitBills;
        S.incomingBills = Array.isArray(j.data.incomingSplitBills) ? j.data.incomingSplitBills : [];
      } else {
        const rSb = await fetch(`${GLOBAL_GS_URL}?action=getSplitBills&username=${uname}&_t=${Date.now()}`);
        const jSb = await rSb.json();
        if (jSb && jSb.status === 'success' && jSb.data) {
          S.allBills = Array.isArray(jSb.data.splitBills) ? jSb.data.splitBills : [];
          S.incomingBills = Array.isArray(jSb.data.incomingSplitBills) ? jSb.data.incomingSplitBills : [];
        }
      }
      saveLocalTransactionsAndCache();
      renderFriendsPicker();
      renderPendingBadge();
      if (S.mainTab === 'list') renderBillsList();
      if (S.activeBillId) refreshOpenDetailModal();
    }
  } catch (e) {}
}

