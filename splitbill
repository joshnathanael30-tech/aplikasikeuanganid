function calcRemainingDays14(createdAtIso) {
  if (!createdAtIso) return 14;
  const createdMs = new Date(createdAtIso).getTime();
  if (isNaN(createdMs)) return 14;
  const deadlineMs = createdMs + (14 * 24 * 60 * 60 * 1000);
  const diffDays = Math.ceil((deadlineMs - Date.now()) / (24 * 60 * 60 * 1000));
  return Math.max(0, diffDays);
}

function getParticipantStatusLabel(statusRaw) {
  const st = String(statusRaw || 'PENDING').toUpperCase();
  if (st === 'PAID') return 'Diterima & Lunas';
  if (st === 'AUTO_PAID_14D') return 'Dipotong Otomatis (14 Hari)';
  if (st === 'REJECT_PENDING') return 'Menolak · Menunggu Konfirmasi Pengirim';
  if (st === 'REJECTED_APPROVED') return 'Penolakan Disetujui';
  return 'Menunggu Konfirmasi';
}

function renderBillsList() {
  const wrap = document.getElementById('bills-list-container');
  if (!wrap) return;

  const uLow = S.akun ? String(S.akun.username || '').toLowerCase() : '';
  let list = (S.allBills || []).slice();

  if (S.listFilter === 'incoming') {
    list = list.filter(b => String(b.creatorUsername || '').toLowerCase() !== uLow);
  } else if (S.listFilter === 'created') {
    list = list.filter(b => String(b.creatorUsername || '').toLowerCase() === uLow);
  }

  if (!list.length) {
    wrap.innerHTML = `
      <div class="mono-card p-8 text-center">
        <p class="text-xs font-black text-zinc-900">Belum Ada Data Split Bill</p>
        <p class="text-[11px] font-medium text-zinc-400 mt-1">Tagihan yang kamu buat atau terima akan tampil di sini.</p>
      </div>
    `;
    return;
  }

  wrap.innerHTML = list.map(bill => {
    const isCreator = String(bill.creatorUsername || '').toLowerCase() === uLow;
    const parts = Array.isArray(bill.participants) ? bill.participants : [];
    const myPart = parts.find(p => String(p.username || '').toLowerCase() === uLow);
    const remDays = calcRemainingDays14(bill.createdAt);

    const paidCount = parts.filter(p => {
      const s = String(p.status || '').toUpperCase();
      return s === 'PAID' || s === 'AUTO_PAID_14D';
    }).length;
    const hasRejectPending = parts.some(p => String(p.status || '').toUpperCase() === 'REJECT_PENDING');

    let badgeHtml = '';
    if (!isCreator && myPart) {
      const mySt = String(myPart.status || 'PENDING').toUpperCase();
      if (mySt === 'PENDING') {
        badgeHtml = `<span class="px-2 py-0.5 rounded-md bg-zinc-900 text-white text-[10px] font-black">Perlu Konfirmasi · ${remDays}h</span>`;
      } else if (mySt === 'REJECT_PENDING') {
        badgeHtml = `<span class="px-2 py-0.5 rounded-md bg-zinc-200 text-zinc-800 text-[10px] font-black">Menunggu Pengirim</span>`;
      } else {
        badgeHtml = `<span class="px-2 py-0.5 rounded-md bg-zinc-100 text-zinc-600 text-[10px] font-bold">${getParticipantStatusLabel(mySt)}</span>`;
      }
    } else {
      if (hasRejectPending) {
        badgeHtml = `<span class="px-2 py-0.5 rounded-md bg-zinc-900 text-white text-[10px] font-black">Ada Penolakan</span>`;
      } else {
        badgeHtml = `<span class="px-2 py-0.5 rounded-md bg-zinc-100 text-zinc-700 text-[10px] font-extrabold">${paidCount}/${parts.length} Selesai</span>`;
      }
    }

    const safeTitle = String(bill.title || 'Split Bill').replace(/</g, '&lt;').replace(/>/g, '&gt;');
    const safeId = String(bill.id).replace(/'/g, "\\'");
    const subInfo = isCreator
      ? `Kamu menagih ${parts.length} teman · Bagianmu ${idr(bill.creatorShareAmount)}`
      : `Dari @${bill.creatorUsername} · Bagianmu ${idr(myPart ? myPart.amount : 0)}`;

    return `
      <div onclick="openDetailModal('${safeId}')" class="mono-card p-4 cursor-pointer active:scale-[0.99] transition">
        <div class="flex items-start justify-between gap-2 mb-2">
          <div class="min-w-0">
            <p class="text-xs font-black text-zinc-900 truncate">${safeTitle}</p>
            <p class="text-[11px] font-semibold text-zinc-500 truncate mt-0.5">${subInfo}</p>
          </div>
          ${badgeHtml}
        </div>
        <div class="pt-2.5 border-t border-zinc-100 flex items-center justify-between text-[11px]">
          <span class="font-semibold text-zinc-400">Total: <b class="text-zinc-900">${idr(bill.totalAmount)}</b></span>
          <span class="font-extrabold text-zinc-900">Buka Detail &amp; Chat →</span>
        </div>
      </div>
    `;
  }).join('');
}

// ── MODAL DETAIL SPLIT BILL, KONFIRMASI TERIMA / TOLAK + ALASAN, & INLINE CHAT ──
window.openDetailModal = function(billId) {
  const bill = (S.allBills || []).find(b => String(b.id) === String(billId));
  if (!bill) return;

  S.activeBillId = bill.id;
  S.inlineChatOpen = false;
  document.getElementById('dt-inline-chat-panel')?.classList.add('hidden');
  toggleRejectReasonForm(false);

  const uLow = S.akun ? String(S.akun.username || '').toLowerCase() : '';
  const isCreator = String(bill.creatorUsername || '').toLowerCase() === uLow;
  const parts = Array.isArray(bill.participants) ? bill.participants : [];

  // Tentukan default lawan bicara untuk Inline Chat
  if (!isCreator) {
    S.inlineChatTargetUsername = bill.creatorUsername;
  } else if (parts.length > 0) {
    S.inlineChatTargetUsername = parts[0].username;
  }

  refreshOpenDetailModal();

  const el = document.getElementById('detail-modal');
  el.style.display = 'flex';
  requestAnimationFrame(() => el.classList.add('show'));
};

window.closeDetailModal = function() {
  S.activeBillId = null;
  S.inlineChatOpen = false;
  if (S.inlineChatTimer) {
    clearInterval(S.inlineChatTimer);
    S.inlineChatTimer = null;
  }
  const el = document.getElementById('detail-modal');
  el.classList.remove('show');
  setTimeout(() => { el.style.display = 'none'; }, 240);
};

function refreshOpenDetailModal() {
  if (!S.activeBillId) return;
  const bill = (S.allBills || []).find(b => String(b.id) === String(S.activeBillId));
  if (!bill) return;

  const uLow = S.akun ? String(S.akun.username || '').toLowerCase() : '';
  const isCreator = String(bill.creatorUsername || '').toLowerCase() === uLow;
  const parts = Array.isArray(bill.participants) ? bill.participants : [];
  const remDays = calcRemainingDays14(bill.createdAt);

  document.getElementById('dt-role-pill').textContent = isCreator ? 'Tagihan Buatanku' : 'Tagihan Masuk';
  document.getElementById('dt-countdown-pill').textContent = remDays > 0
    ? `Otomatis potong dlm ${remDays} hari`
    : 'Batas 14 hari tercapai';
  document.getElementById('dt-title').textContent    = bill.title || 'Split Bill';
  document.getElementById('dt-meta').textContent     = `Oleh ${bill.creatorNamaLengkap || bill.creatorUsername} (@${bill.creatorUsername})`;
  document.getElementById('dt-total').textContent    = idr(bill.totalAmount);
  document.getElementById('dt-category').textContent = bill.category || 'Lainnya';

  // Render daftar semua orang (Pembuat + Semua Peserta)
  let listHtml = `
    <div class="p-3 rounded-xl bg-zinc-50 border border-zinc-200 flex items-center justify-between gap-2">
      <div class="min-w-0">
        <p class="text-xs font-black text-zinc-900 truncate">${bill.creatorNamaLengkap || bill.creatorUsername} ${isCreator ? '(Kamu)' : ''}</p>
        <p class="text-[10px] font-bold text-zinc-400">@${bill.creatorUsername} · Pembuat</p>
      </div>
      <div class="text-right flex-shrink-0">
        <p class="text-xs font-black text-zinc-900">${idr(bill.creatorShareAmount)}</p>
        <span class="text-[10px] font-bold text-zinc-500">Sudah Terpotong</span>
      </div>
    </div>
  `;

  listHtml += parts.map(p => {
    const pLow = String(p.username || '').toLowerCase();
    const isMe = pLow === uLow;
    const st   = String(p.status || 'PENDING').toUpperCase();
    const safeName = String(p.namaLengkap || p.username).replace(/</g, '&lt;').replace(/>/g, '&gt;');
    const safeU    = String(p.username).replace(/'/g, "\\'");
    const reasonHtml = p.rejectReason
      ? `<p class="text-[10px] font-bold text-zinc-700 bg-zinc-100 px-2 py-1 rounded-lg mt-1">Alasan tolak: "${String(p.rejectReason).replace(/</g, '&lt;')}"</p>`
      : '';

    // Jika kita adalah pembuat dan peserta ini berstatus REJECT_PENDING, tampilkan tombol konfirmasi pengirim
    const creatorConfirmBtns = (isCreator && st === 'REJECT_PENDING')
      ? `<div class="flex gap-1.5 mt-2">
           <button type="button" onclick="submitCreatorRejectResponse('${safeU}', 'approve_reject')" class="px-2.5 py-1 rounded-lg bg-zinc-900 text-white text-[10px] font-extrabold">Setujui Penolakan</button>
           <button type="button" onclick="submitCreatorRejectResponse('${safeU}', 'deny_reject')" class="px-2.5 py-1 rounded-lg bg-white border border-zinc-300 text-zinc-800 text-[10px] font-extrabold">Tetap Tagih</button>
         </div>`
      : '';

    return `
      <div class="p-3 rounded-xl bg-white border ${isMe ? 'border-zinc-900' : 'border-zinc-200'}">
        <div class="flex items-center justify-between gap-2">
          <div class="min-w-0">
            <p class="text-xs font-black text-zinc-900 truncate">${safeName} ${isMe ? '(Kamu)' : ''}</p>
            <p class="text-[10px] font-bold text-zinc-400">@${p.username}</p>
          </div>
          <div class="text-right flex-shrink-0">
            <p class="text-xs font-black text-zinc-900">${idr(p.amount)}</p>
            <span class="text-[10px] font-bold ${st === 'PAID' || st === 'AUTO_PAID_14D' ? 'text-zinc-900' : 'text-zinc-500'}">${getParticipantStatusLabel(st)}</span>
          </div>
        </div>
        ${reasonHtml}
        ${creatorConfirmBtns}
      </div>
    `;
  }).join('');

  document.getElementById('dt-participants-list').innerHTML = listHtml;

  // Kotak aksi untuk penerima
  const myPart = parts.find(p => String(p.username || '').toLowerCase() === uLow);
  const actionBox  = document.getElementById('dt-receiver-action-box');
  const waitingBox = document.getElementById('dt-waiting-creator-box');

  if (!isCreator && myPart) {
    const mySt = String(myPart.status || 'PENDING').toUpperCase();
    if (mySt === 'PENDING') {
      actionBox.classList.remove('hidden');
      waitingBox.classList.add('hidden');
      document.getElementById('dt-my-share').textContent = idr(myPart.amount);
      populateDompetOptions('dt-pay-dompet');
    } else if (mySt === 'REJECT_PENDING') {
      actionBox.classList.add('hidden');
      waitingBox.classList.remove('hidden');
      document.getElementById('dt-waiting-reason-text').textContent =
        `Alasanmu: "${myPart.rejectReason || '-'}" — Menunggu konfirmasi dari @${bill.creatorUsername}.`;
    } else {
      actionBox.classList.add('hidden');
      waitingBox.classList.add('hidden');
    }
  } else {
    actionBox.classList.add('hidden');
    waitingBox.classList.add('hidden');
  }

  // Konfigurasi Label & Target Inline Chat
  const toggleLbl = document.getElementById('dt-chat-toggle-label');
  const partnerTag = document.getElementById('dt-chat-partner-Tag');
  const targetSelWrap = document.getElementById('dt-chat-target-selector');

  if (!isCreator) {
    toggleLbl.textContent = '💬 Chat dengan Pengirim';
    partnerTag.textContent = '@' + bill.creatorUsername + (S.inlineChatOpen ? ' ▴' : ' ▾');
    targetSelWrap.classList.add('hidden');
  } else {
    toggleLbl.textContent = '💬 Chat dengan Teman di Bill Ini';
    partnerTag.textContent = '@' + (S.inlineChatTargetUsername || '') + (S.inlineChatOpen ? ' ▴' : ' ▾');
    if (parts.length > 1) {
      targetSelWrap.classList.remove('hidden');
      targetSelWrap.innerHTML = parts.map(p => {
        const active = String(p.username).toLowerCase() === String(S.inlineChatTargetUsername).toLowerCase();
        const safeU = String(p.username).replace(/'/g, "\\'");
        return `<button type="button" onclick="selectInlineChatPartner('${safeU}')" class="px-2.5 py-1 rounded-lg text-[10px] font-extrabold border flex-shrink-0 ${active ? 'bg-zinc-900 text-white border-zinc-900' : 'bg-white text-zinc-700 border-zinc-200'}">@${p.username}</button>`;
      }).join('');
    } else {
      targetSelWrap.classList.add('hidden');
    }
  }
}

window.toggleRejectReasonForm = function(show) {
  const mainBtns  = document.getElementById('dt-main-decision-btns');
  const reasonBox = document.getElementById('dt-reject-reason-box');
  if (show) {
    mainBtns?.classList.add('hidden');
    reasonBox?.classList.remove('hidden');
    onRejectReasonRadioChange();
  } else {
    mainBtns?.classList.remove('hidden');
    reasonBox?.classList.add('hidden');
  }
};

window.onRejectReasonRadioChange = function() {
  const checked = document.querySelector('input[name="sb_reject_reason"]:checked');
  const customInp = document.getElementById('dt-reject-custom-input');
  if (!customInp) return;
  if (checked && checked.value === 'custom') {
    customInp.classList.remove('hidden');
    customInp.focus();
  } else {
    customInp.classList.add('hidden');
  }
};

window.submitReceiverDecision = async function(decision) {
  if (!S.activeBillId || !S.akun) return;
  const bill = (S.allBills || []).find(b => String(b.id) === String(S.activeBillId));
  if (!bill) return;

  const uLow = String(S.akun.username || '').toLowerCase();
  const myPart = (bill.participants || []).find(p => String(p.username || '').toLowerCase() === uLow);
  if (!myPart) return;

  let rejectReason = '';
  if (decision === 'reject') {
    const checked = document.querySelector('input[name="sb_reject_reason"]:checked');
    if (checked && checked.value === 'custom') {
      rejectReason = String(document.getElementById('dt-reject-custom-input')?.value || '').trim();
      if (!rejectReason) {
        showToast('Tulis alasan penolakanmu terlebih dahulu.');
        return;
      }
    } else {
      rejectReason = checked ? checked.value : 'Nominal tidak sesuai';
    }
  }

  const dompetId = document.getElementById('dt-pay-dompet')?.value || (S.dompetList[0] ? S.dompetList[0].id : '');
  const shareAmt = Number(myPart.amount) || 0;

  if (decision === 'confirm' && dompetId) {
    const avail = hitungSaldoDompet(dompetId);
    if (shareAmt > avail) {
      showToast(`Saldo dompet tidak cukup (${idr(avail)}).`);
      return;
    }
  }

  const btnAccept = document.getElementById('btn-accept-bill');
  const btnReject = document.getElementById('btn-submit-reject');
  if (btnAccept) btnAccept.disabled = true;
  if (btnReject) btnReject.disabled = true;

  const res = await callMasterApi('respondSplitBill', {
    splitBillId: bill.id,
    username: S.akun.username,
    decision: decision,
    dompetId: dompetId,
    rejectReason: rejectReason
  });

  if (btnAccept) btnAccept.disabled = false;
  if (btnReject) btnReject.disabled = false;

  if (res && res.status === 'success') {
    if (decision === 'confirm') {
      myPart.status = 'PAID';
      const newTx = (res.data && res.data.payerTransaction) ? res.data.payerTransaction : {
        id: 'sb_pay_' + bill.id + '_' + uLow,
        'Kategori': 'Uang Keluar',
        'Kategori Uang Keluar': bill.category || 'Makanan & Minuman',
        'Jumlah Uang': shareAmt,
        'Tanggal': new Date().toISOString(),
        'Deskripsi': `Bayar Split Bill: ${bill.title} (ke @${bill.creatorUsername})`,
        'DompetId': dompetId || null
      };
      if (!S.transactions.some(t => String(t.id) === String(newTx.id))) {
        S.transactions.unshift(newTx);
      }
      showToast(`Split Bill diterima & dibayar (${idr(shareAmt)}).`);
    } else {
      myPart.status = 'REJECT_PENDING';
      myPart.rejectReason = rejectReason;
      showToast('Penolakan dikirim. Menunggu konfirmasi pengirim.');
    }

    S.incomingBills = (S.incomingBills || []).filter(b => String(b.id) !== String(bill.id));
    saveLocalTransactionsAndCache();
    renderPendingBadge();
    renderBillsList();
    refreshOpenDetailModal();
    // Buka otomatis panel inline chat agar penerima bisa langsung berdiskusi dengan pengirim
    if (!S.inlineChatOpen) toggleInlineChatPanel();
  } else {
    showToast((res && res.message) || 'Gagal memproses Split Bill.');
  }
};

window.submitCreatorRejectResponse = async function(participantUsername, decision) {
  if (!S.activeBillId || !S.akun) return;
  const res = await callMasterApi('creatorRespondReject', {
    splitBillId: S.activeBillId,
    creatorUsername: S.akun.username,
    participantUsername: participantUsername,
    decision: decision
  });
  if (res && res.status === 'success') {
    showToast(res.message || 'Status diperbarui.');
    syncSplitBillAndFriends();
  } else {
    showToast((res && res.message) || 'Gagal memperbarui status.');
  }
};

// ── INLINE CHAT LANGSUNG DI DALAM MODAL SPLIT BILL (TANPA REDIRECT KE /CHAT) ──
function buildRoomId(u1, u2) {
  return [String(u1 || '').trim().toLowerCase(), String(u2 || '').trim().toLowerCase()].sort().join('__');
}

window.selectInlineChatPartner = function(username) {
  S.inlineChatTargetUsername = username;
  refreshOpenDetailModal();
  if (S.inlineChatOpen) {
    fetchInlineChatMessages();
  }
};

window.toggleInlineChatPanel = function() {
  S.inlineChatOpen = !S.inlineChatOpen;
  const panel = document.getElementById('dt-inline-chat-panel');
  if (panel) panel.classList.toggle('hidden', !S.inlineChatOpen);
  refreshOpenDetailModal();

  if (S.inlineChatTimer) {
    clearInterval(S.inlineChatTimer);
    S.inlineChatTimer = null;
  }

  if (S.inlineChatOpen && S.inlineChatTargetUsername) {
    fetchInlineChatMessages();
    S.inlineChatTimer = setInterval(fetchInlineChatMessages, 3500);
    setTimeout(() => document.getElementById('dt-inline-chat-input')?.focus(), 100);
  }
};

async function fetchInlineChatMessages() {
  if (!S.akun || !S.inlineChatTargetUsername) return;
  const roomId = buildRoomId(S.akun.username, S.inlineChatTargetUsername);
  const res = await callMasterApi('getChatMessages', {
    username: S.akun.username,
    friendUsername: S.inlineChatTargetUsername,
    roomId: roomId,
    afterTimestamp: ''
  });
  if (res && res.status === 'success' && res.data && Array.isArray(res.data.messages)) {
    S.inlineChatMessages[roomId] = res.data.messages;
    renderInlineChatStream();
  }
}

function renderInlineChatStream() {
  const stream = document.getElementById('dt-inline-chat-stream');
  if (!stream || !S.akun || !S.inlineChatTargetUsername) return;
  const roomId = buildRoomId(S.akun.username, S.inlineChatTargetUsername);
  const msgs = S.inlineChatMessages[roomId] || [];

  if (!msgs.length) {
    stream.innerHTML = `<p class="text-[11px] font-semibold text-zinc-400 text-center my-auto">Belum ada pesan dengan @${S.inlineChatTargetUsername}. Kirim pesan langsung di bawah.</p>`;
    return;
  }

  const myLow = String(S.akun.username || '').toLowerCase();
  stream.innerHTML = msgs.map(m => {
    const isMe = String(m.senderUsername || '').toLowerCase() === myLow;
    const safeMsg = String(m.message || '').replace(/</g, '&lt;').replace(/>/g, '&gt;');
    return `<div class="${isMe ? 'chat-bubble-me' : 'chat-bubble-other'}">${safeMsg}</div>`;
  }).join('');
  stream.scrollTop = stream.scrollHeight;
}

window.handleSendInlineChat = async function(e) {
  e.preventDefault();
  const inp = document.getElementById('dt-inline-chat-input');
  const text = String(inp?.value || '').trim();
  if (!text || !S.akun || !S.inlineChatTargetUsername) return;

  inp.value = '';
  const roomId = buildRoomId(S.akun.username, S.inlineChatTargetUsername);
  if (!S.inlineChatMessages[roomId]) S.inlineChatMessages[roomId] = [];

  const tempId = 'inline_' + Date.now();
  S.inlineChatMessages[roomId].push({
    id: tempId,
    roomId: roomId,
    senderUsername: S.akun.username,
    receiverUsername: S.inlineChatTargetUsername,
    message: text,
    createdAt: new Date().toISOString()
  });
  renderInlineChatStream();

  await callMasterApi('sendChatMessage', {
    clientMsgId: tempId,
    senderUsername: S.akun.username,
    receiverUsername: S.inlineChatTargetUsername,
    message: text
  });
  fetchInlineChatMessages();
};

