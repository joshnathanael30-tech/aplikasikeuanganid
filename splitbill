<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
<title>Split Bill — Keloladuit.id</title>
<script src="https://cdn.tailwindcss.com"></script>
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
<script>
(function() {
  var RELOAD_KEY = 'keuangan_tailwind_reload_count_sb';
  var MAX_RELOADS = 2;
  var CHECK_DELAY_MS = 2500;
  function getReloadCount() {
    try { return parseInt(sessionStorage.getItem(RELOAD_KEY) || '0', 10); } catch(e) { return 0; }
  }
  function setReloadCount(n) {
    try { sessionStorage.setItem(RELOAD_KEY, String(n)); } catch(e) {}
  }
  window.addEventListener('DOMContentLoaded', function() {
    setTimeout(function() {
      var test = document.createElement('div');
      test.className = 'flex';
      test.style.position = 'absolute';
      test.style.visibility = 'hidden';
      test.style.pointerEvents = 'none';
      document.body.appendChild(test);
      var computedDisplay = window.getComputedStyle(test).display;
      document.body.removeChild(test);
      if (computedDisplay !== 'flex') {
        var count = getReloadCount();
        if (count < MAX_RELOADS) {
          setReloadCount(count + 1);
          location.reload();
        }
      } else {
        setReloadCount(0);
      }
    }, CHECK_DELAY_MS);
  });
})();
</script>
<style>
* { -webkit-tap-highlight-color: transparent; box-sizing: border-box; }
body {
  font-family: 'Plus Jakarta Sans', sans-serif;
  background: #FAFAFA;
  color: #111111;
  margin: 0;
  padding-bottom: 48px;
  overflow-x: hidden;
}
.mono-card {
  background: #FFFFFF;
  border: 1px solid #E4E4E7;
  border-radius: 20px;
}
.mono-input {
  background: #F4F4F5;
  border: 1.5px solid transparent;
  border-radius: 14px;
  padding: 12px 14px;
  width: 100%;
  font-size: 13px;
  font-weight: 700;
  color: #111111;
  outline: none;
  font-family: inherit;
  transition: border-color 0.18s, background 0.18s;
}
.mono-input:focus {
  background: #FFFFFF;
  border-color: #111111;
}
.mono-input::placeholder {
  color: #A1A1AA;
  font-weight: 500;
}
.btn-black {
  background: #111111;
  color: #FFFFFF;
  border: 1.5px solid #111111;
  border-radius: 14px;
  font-weight: 800;
  cursor: pointer;
  transition: transform 0.12s, opacity 0.15s;
}
.btn-black:active { transform: scale(0.98); }
.btn-black:disabled { opacity: 0.45; cursor: not-allowed; }
.btn-outline {
  background: #FFFFFF;
  color: #111111;
  border: 1.5px solid #E4E4E7;
  border-radius: 14px;
  font-weight: 800;
  cursor: pointer;
  transition: transform 0.12s, border-color 0.15s, background 0.15s;
}
.btn-outline:hover { border-color: #111111; }
.btn-outline:active { transform: scale(0.98); }

.tab-switch-wrap {
  display: flex;
  background: #F4F4F5;
  padding: 4px;
  border-radius: 16px;
  gap: 4px;
}
.tab-switch-btn {
  flex: 1;
  padding: 10px 12px;
  border-radius: 12px;
  font-size: 12px;
  font-weight: 800;
  border: none;
  cursor: pointer;
  transition: all 0.18s;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 6px;
}
.tab-switch-btn.active {
  background: #111111;
  color: #FFFFFF;
}
.tab-switch-btn:not(.active) {
  background: transparent;
  color: #71717A;
}

.modal-overlay {
  position: fixed;
  inset: 0;
  z-index: 60;
  background: rgba(17, 17, 17, 0.48);
  backdrop-filter: blur(4px);
  display: none;
  align-items: flex-end;
  justify-content: center;
  opacity: 0;
  transition: opacity 0.22s ease;
}
.modal-overlay.show { opacity: 1; }
.modal-sheet {
  width: 100%;
  max-width: 480px;
  max-height: 92vh;
  overflow-y: auto;
  background: #FFFFFF;
  border-radius: 26px 26px 0 0;
  padding: 22px 20px 30px;
  transform: translateY(100%);
  transition: transform 0.28s cubic-bezier(0.22, 1, 0.36, 1);
}
.modal-overlay.show .modal-sheet { transform: translateY(0); }

@media (min-width: 640px) {
  .modal-overlay { align-items: center; padding: 20px; }
  .modal-sheet { border-radius: 24px; transform: scale(0.96); }
  .modal-overlay.show .modal-sheet { transform: scale(1); }
}

.chat-bubble-me {
  align-self: flex-end;
  max-width: 80%;
  background: #111111;
  color: #FFFFFF;
  border-radius: 16px 16px 4px 16px;
  padding: 9px 13px;
  font-size: 12px;
  line-height: 1.45;
  word-break: break-word;
}
.chat-bubble-other {
  align-self: flex-start;
  max-width: 80%;
  background: #F4F4F5;
  color: #111111;
  border: 1px solid #E4E4E7;
  border-radius: 16px 16px 16px 4px;
  padding: 9px 13px;
  font-size: 12px;
  line-height: 1.45;
  word-break: break-word;
}
.no-scroll::-webkit-scrollbar { display: none; }
.no-scroll { -ms-overflow-style: none; scrollbar-width: none; }
</style>
</head>
<body>

<!-- ═══════════ TOAST FEEDBACK ═══════════ -->
<div id="toast-box" class="fixed top-4 left-1/2 -translate-x-1/2 z-[95] hidden px-4 py-2.5 rounded-xl bg-zinc-900 text-white text-xs font-extrabold shadow-lg flex items-center gap-2 max-w-xs text-center">
  <span id="toast-text">Tersimpan</span>
</div>

<!-- ═══════════ CONTAINER UTAMA ═══════════ -->
<div class="max-w-md mx-auto min-h-screen flex flex-col">

  <!-- HEADER CLEAN MONOCHROME + TOMBOL "?" -->
  <header class="pt-8 pb-3.5 px-5 sticky top-0 z-20 bg-[#FAFAFA]/95 backdrop-blur-md border-b border-zinc-200/80">
    <div class="flex items-center justify-between">
      <div class="flex items-center gap-3">
        <a href="https://keloladuit.my.id/home" target="_top" onclick="goBackHome(event)" class="w-10 h-10 rounded-xl bg-white border border-zinc-200 flex items-center justify-center text-zinc-900 active:scale-95 transition-transform" style="text-decoration:none" aria-label="Kembali">
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/>
          </svg>
        </a>
        <div>
          <h1 class="text-base font-black text-zinc-900 leading-tight">Split Bill</h1>
          <p id="my-user-label" class="text-[11px] font-bold text-zinc-400 mt-0.5">@pengguna</p>
        </div>
      </div>

      <!-- Tombol "?" (Pop-up Penjelasan) -->
      <button type="button" onclick="openHelpModal()" class="w-9 h-9 rounded-full bg-zinc-900 text-white text-sm font-black flex items-center justify-center active:scale-90 transition-transform" title="Cara Kerja Split Bill" aria-label="Bantuan Split Bill">
        ?
      </button>
    </div>
  </header>

  <main class="px-5 pt-4 space-y-4 flex-1">

    <!-- 2 TAB UTAMA: BUAT SPLIT BILL | TAGIHAN & RIWAYAT -->
    <div class="tab-switch-wrap">
      <button type="button" id="tab-btn-create" onclick="switchMainTab('create')" class="tab-switch-btn active">
        <span>Buat Baru</span>
      </button>
      <button type="button" id="tab-btn-list" onclick="switchMainTab('list')" class="tab-switch-btn">
        <span>Tagihan &amp; Riwayat</span>
        <span id="badge-pending-count" class="hidden px-1.5 py-0.5 rounded-full bg-white text-zinc-900 text-[10px] font-black leading-none">0</span>
      </button>
    </div>

    <!-- ═══ PANE 1: FORM BUAT SPLIT BILL ═══ -->
    <section id="pane-create" class="space-y-3.5">
      <form id="sb-form" onsubmit="handleCreateSplitBill(event)" class="mono-card p-4 space-y-3.5">

        <div class="grid grid-cols-2 gap-2.5">
          <div>
            <label class="text-[10px] font-extrabold text-zinc-400 uppercase tracking-wider block mb-1">Nama Tagihan</label>
            <input type="text" id="sb-title" placeholder="Cth: Makan Malam" class="mono-input" required>
          </div>
          <div>
            <label class="text-[10px] font-extrabold text-zinc-400 uppercase tracking-wider block mb-1">Kategori</label>
            <select id="sb-category" class="mono-input"></select>
          </div>
        </div>

        <div>
          <label class="text-[10px] font-extrabold text-zinc-400 uppercase tracking-wider block mb-1">Dompet Pembayaran Awal</label>
          <select id="sb-dompet" class="mono-input"></select>
        </div>

        <div class="grid grid-cols-2 gap-2.5">
          <div>
            <label class="text-[10px] font-extrabold text-zinc-400 uppercase tracking-wider block mb-1">Jumlah Total (Rp)</label>
            <input type="number" id="sb-total-amount" placeholder="0" min="1" class="mono-input text-sm font-black" required oninput="onTotalOrOwnInput('total')">
          </div>
          <div>
            <label class="text-[10px] font-extrabold text-zinc-400 uppercase tracking-wider block mb-1">Bagian Kita (Rp)</label>
            <input type="number" id="sb-own-amount" placeholder="0" min="0" class="mono-input text-sm font-black" required oninput="onTotalOrOwnInput('own')">
          </div>
        </div>

        <!-- Pemilihan Teman (Hanya Teman ACCEPTED) -->
        <div>
          <div class="flex items-center justify-between mb-1.5">
            <label class="text-[10px] font-extrabold text-zinc-400 uppercase tracking-wider">Pilih Teman</label>
            <div class="flex items-center gap-1.5">
              <button type="button" onclick="divideEquallyAll()" class="px-2.5 py-1 rounded-lg bg-zinc-100 hover:bg-zinc-200 text-zinc-800 text-[10px] font-extrabold transition">Bagi Rata</button>
              <button type="button" onclick="divideRemainderFriends()" class="px-2.5 py-1 rounded-lg bg-zinc-100 hover:bg-zinc-200 text-zinc-800 text-[10px] font-extrabold transition">Bagi Sisa</button>
            </div>
          </div>

          <div id="friends-chip-list" class="flex flex-wrap gap-1.5 mb-2.5 max-h-28 overflow-y-auto"></div>
          <div id="selected-friends-inputs" class="space-y-2 max-h-52 overflow-y-auto"></div>
        </div>

        <!-- Ringkasan Singkat -->
        <div class="p-3 rounded-2xl bg-zinc-50 border border-zinc-200/80 space-y-1 text-xs">
          <div class="flex justify-between">
            <span class="text-zinc-500 font-semibold">Total Tagihan</span>
            <span id="sum-total" class="font-black text-zinc-900">Rp 0</span>
          </div>
          <div class="flex justify-between">
            <span class="text-zinc-500 font-semibold">Bagian Kita</span>
            <span id="sum-own" class="font-black text-zinc-900">Rp 0</span>
          </div>
          <div class="flex justify-between">
            <span class="text-zinc-500 font-semibold">Total Ditagih ke Teman</span>
            <span id="sum-friends" class="font-black text-zinc-900">Rp 0</span>
          </div>
          <div class="pt-1.5 border-t border-zinc-200 flex justify-between items-center">
            <span class="text-zinc-500 font-bold">Validasi</span>
            <span id="sum-status" class="font-black text-zinc-400">Isi nominal</span>
          </div>
        </div>

        <p id="form-err" class="text-xs font-bold text-zinc-900 bg-zinc-100 p-2.5 rounded-xl text-center hidden"></p>

        <button type="submit" id="btn-submit-sb" class="w-full py-3.5 btn-black text-xs uppercase tracking-wider">
          Kirim Split Bill
        </button>
      </form>
    </section>

    <!-- ═══ PANE 2: DAFTAR TAGIHAN & RIWAYAT SPLIT BILL ═══ -->
    <section id="pane-list" class="hidden space-y-3">
      <!-- Filter Sub-Tab -->
      <div class="flex gap-1.5 overflow-x-auto no-scroll pb-1">
        <button type="button" id="flt-all" onclick="setListFilter('all')" class="px-3 py-1.5 rounded-full text-[11px] font-extrabold bg-zinc-900 text-white">Semua</button>
        <button type="button" id="flt-incoming" onclick="setListFilter('incoming')" class="px-3 py-1.5 rounded-full text-[11px] font-extrabold bg-white border border-zinc-200 text-zinc-600">Ditagih ke Saya</button>
        <button type="button" id="flt-created" onclick="setListFilter('created')" class="px-3 py-1.5 rounded-full text-[11px] font-extrabold bg-white border border-zinc-200 text-zinc-600">Tagihan Buatanku</button>
      </div>

      <div id="bills-list-container" class="space-y-2.5"></div>
    </section>

  </main>
</div>

<!-- ═══════════════════════════════════════════════════════════════════════════
     POP-UP TOMBOL "?" (PENJELASAN SINGKAT SPLIT BILL)
═══════════════════════════════════════════════════════════════════════════ -->
<div id="help-modal" class="modal-overlay" onclick="if(event.target===this)closeHelpModal()">
  <div class="modal-sheet">
    <div class="w-10 h-1 bg-zinc-200 rounded-full mx-auto mb-4"></div>
    <div class="flex items-center justify-between mb-3">
      <h3 class="text-base font-black text-zinc-900">Cara Kerja Split Bill</h3>
      <button type="button" onclick="closeHelpModal()" class="w-8 h-8 rounded-full bg-zinc-100 text-zinc-600 font-black text-xs">✕</button>
    </div>
    <div class="space-y-2.5 text-xs text-zinc-600 font-medium leading-relaxed">
      <div class="p-3 rounded-xl bg-zinc-50 border border-zinc-200/80">
        <p class="font-black text-zinc-900 mb-0.5">1. Khusus Sesama Teman</p>
        <p>Hanya pengguna yang sudah berteman denganmu yang dapat dimasukkan ke dalam Split Bill.</p>
      </div>
      <div class="p-3 rounded-xl bg-zinc-50 border border-zinc-200/80">
        <p class="font-black text-zinc-900 mb-0.5">2. Potong Saldo Pembuat di Awal</p>
        <p>Saat kamu mengirim Split Bill, saldo dompetmu terpotong sebesar <b>Jumlah Total</b> terlebih dahulu.</p>
      </div>
      <div class="p-3 rounded-xl bg-zinc-50 border border-zinc-200/80">
        <p class="font-black text-zinc-900 mb-0.5">3. Konfirmasi Penerima (Terima / Tolak)</p>
        <p>Teman yang ditagih dapat melihat seluruh rincian setiap orang. Jika <b>Terima</b>, saldo mereka terpotong dan masuk ke dompetmu. Jika <b>Tolak</b>, mereka memilih alasan dan menunggu konfirmasimu.</p>
      </div>
      <div class="p-3 rounded-xl bg-zinc-50 border border-zinc-200/80">
        <p class="font-black text-zinc-900 mb-0.5">4. Potong Otomatis 14 Hari</p>
        <p>Jika penerima tidak memberi konfirmasi dalam <b>14 hari</b>, sistem otomatis memotong saldo penerima.</p>
      </div>
    </div>
    <button type="button" onclick="closeHelpModal()" class="w-full mt-4 py-3 btn-black text-xs">Mengerti</button>
  </div>
</div>

<!-- ═══════════════════════════════════════════════════════════════════════════
     MODAL DETAIL SPLIT BILL, KONFIRMASI (TERIMA / TOLAK + ALASAN), & INLINE CHAT
═══════════════════════════════════════════════════════════════════════════ -->
<div id="detail-modal" class="modal-overlay" onclick="if(event.target===this)closeDetailModal()">
  <div class="modal-sheet">
    <div class="w-10 h-1 bg-zinc-200 rounded-full mx-auto mb-4"></div>

    <!-- Header Detail -->
    <div class="flex items-start justify-between gap-3 mb-3">
      <div class="min-w-0">
        <div class="flex items-center gap-1.5 mb-1">
          <span id="dt-role-pill" class="px-2 py-0.5 rounded-md bg-zinc-900 text-white text-[10px] font-black uppercase">Split Bill</span>
          <span id="dt-countdown-pill" class="px-2 py-0.5 rounded-md bg-zinc-100 text-zinc-600 text-[10px] font-bold">⏳ 14 hari</span>
        </div>
        <h3 id="dt-title" class="text-base font-black text-zinc-900 truncate">Nama Tagihan</h3>
        <p id="dt-meta" class="text-[11px] font-semibold text-zinc-400 mt-0.5">Dibuat oleh @user</p>
      </div>
      <button type="button" onclick="closeDetailModal()" class="w-8 h-8 rounded-full bg-zinc-100 text-zinc-600 font-black text-xs flex-shrink-0">✕</button>
    </div>

    <!-- Kotak Total Monokrom Hitam -->
    <div class="p-4 rounded-2xl bg-zinc-900 text-white mb-3.5 flex items-center justify-between">
      <div>
        <p class="text-[10px] font-bold text-zinc-400 uppercase tracking-wider">Jumlah Total</p>
        <p id="dt-total" class="text-xl font-black mt-0.5">Rp 0</p>
      </div>
      <div class="text-right">
        <p class="text-[10px] font-bold text-zinc-400 uppercase tracking-wider">Kategori</p>
        <p id="dt-category" class="text-xs font-extrabold text-zinc-200 mt-0.5">Makanan</p>
      </div>
    </div>

    <!-- Daftar Rincian Semua Orang (Pembuat + Teman-teman) -->
    <div class="mb-3.5">
      <p class="text-[10px] font-extrabold text-zinc-400 uppercase tracking-wider mb-2">Rincian Bagian Semua Orang</p>
      <div id="dt-participants-list" class="space-y-2 max-h-52 overflow-y-auto pr-0.5"></div>
    </div>

    <!-- KOTAK AKSI PENERIMA: TERIMA / TOLAK (MUNCUL JIKA USER ADALAH PENERIMA & STATUS PENDING) -->
    <div id="dt-receiver-action-box" class="hidden p-3.5 rounded-2xl bg-zinc-50 border border-zinc-200 space-y-3 mb-3.5">
      <div class="flex items-center justify-between">
        <span class="text-xs font-bold text-zinc-600">Tagihan Bagianmu</span>
        <span id="dt-my-share" class="text-sm font-black text-zinc-900">Rp 0</span>
      </div>

      <div>
        <label class="text-[10px] font-extrabold text-zinc-400 uppercase block mb-1">Potong dari Dompet</label>
        <select id="dt-pay-dompet" class="mono-input !bg-white border border-zinc-200"></select>
      </div>

      <!-- Tombol Utama Terima / Tolak -->
      <div id="dt-main-decision-btns" class="grid grid-cols-2 gap-2">
        <button type="button" onclick="toggleRejectReasonForm(true)" class="py-3 btn-outline text-xs">
          Tolak
        </button>
        <button type="button" id="btn-accept-bill" onclick="submitReceiverDecision('confirm')" class="py-3 btn-black text-xs">
          Terima &amp; Bayar
        </button>
      </div>

      <!-- Sub-Form Opsi Alasan Penolakan (Muncul Saat Klik Tolak) -->
      <div id="dt-reject-reason-box" class="hidden pt-2 border-t border-zinc-200 space-y-2.5">
        <p class="text-[11px] font-extrabold text-zinc-800">Pilih Alasan Penolakan:</p>
        <div class="space-y-1.5">
          <label class="flex items-center gap-2.5 p-2.5 rounded-xl bg-white border border-zinc-200 cursor-pointer text-xs font-bold text-zinc-800">
            <input type="radio" name="sb_reject_reason" value="Nominal tidak sesuai" checked onchange="onRejectReasonRadioChange()" class="accent-zinc-900">
            <span>Nominal tidak sesuai</span>
          </label>
          <label class="flex items-center gap-2.5 p-2.5 rounded-xl bg-white border border-zinc-200 cursor-pointer text-xs font-bold text-zinc-800">
            <input type="radio" name="sb_reject_reason" value="Saya tidak merasa memiliki ini" onchange="onRejectReasonRadioChange()" class="accent-zinc-900">
            <span>Saya tidak merasa memiliki ini</span>
          </label>
          <label class="flex items-center gap-2.5 p-2.5 rounded-xl bg-white border border-zinc-200 cursor-pointer text-xs font-bold text-zinc-800">
            <input type="radio" name="sb_reject_reason" value="custom" onchange="onRejectReasonRadioChange()" class="accent-zinc-900">
            <span>Lainnya (isi sendiri)</span>
          </label>
        </div>

        <input type="text" id="dt-reject-custom-input" placeholder="Tulis alasan penolakanmu…" class="mono-input !bg-white border border-zinc-300 hidden">

        <div class="flex gap-2">
          <button type="button" onclick="toggleRejectReasonForm(false)" class="px-4 py-2.5 btn-outline text-xs">Batal</button>
          <button type="button" id="btn-submit-reject" onclick="submitReceiverDecision('reject')" class="flex-1 py-2.5 btn-black text-xs">
            Kirim Penolakan
          </button>
        </div>
      </div>
    </div>

    <!-- INFO STATUS MENUNGGU KONFIRMASI PENGIRIM (MUNCUL SETELAH PENERIMA MENOLAK) -->
    <div id="dt-waiting-creator-box" class="hidden p-3.5 rounded-2xl bg-zinc-100 border border-zinc-300 mb-3.5">
      <p class="text-xs font-black text-zinc-900">⏳ Menunggu Konfirmasi Pengirim</p>
      <p id="dt-waiting-reason-text" class="text-[11px] font-semibold text-zinc-600 mt-0.5">Alasan penolakanmu telah dikirim ke pengirim.</p>
    </div>

    <!-- TOMBOL & PANEL INLINE CHAT (LANGSUNG KIRIM PESAN TANPA PINDAH HALAMAN) -->
    <div class="border-t border-zinc-200 pt-3">
      <div class="flex items-center justify-between mb-2">
        <button type="button" onclick="toggleInlineChatPanel()" class="w-full py-2.5 px-3.5 rounded-xl bg-zinc-100 hover:bg-zinc-200 text-zinc-900 text-xs font-extrabold flex items-center justify-between transition">
          <span id="dt-chat-toggle-label">💬 Chat dengan Pengirim</span>
          <span id="dt-chat-partner-Tag" class="text-[11px] font-bold text-zinc-500">@username ▾</span>
        </button>
      </div>

      <!-- Pilihan lawan chat (jika kita pembuat dan peserta > 1 teman) -->
      <div id="dt-chat-target-selector" class="hidden flex gap-1.5 overflow-x-auto no-scroll mb-2"></div>

      <!-- Kotak Inline Chat -->
      <div id="dt-inline-chat-panel" class="hidden rounded-2xl border border-zinc-200 bg-white overflow-hidden">
        <div id="dt-inline-chat-stream" class="p-3 max-h-44 min-h-[110px] overflow-y-auto flex flex-col gap-2 bg-[#FAFAFA]">
          <p class="text-[11px] text-zinc-400 text-center my-auto">Memuat obrolan…</p>
        </div>
        <form onsubmit="handleSendInlineChat(event)" class="p-2 bg-white border-t border-zinc-200 flex items-center gap-2">
          <input type="text" id="dt-inline-chat-input" placeholder="Ketik pesan langsung di sini…" class="mono-input !py-2 !px-3 !text-xs flex-1">
          <button type="submit" class="px-3.5 py-2 btn-black text-xs flex-shrink-0">Kirim</button>
