// ── FORM PEMBUATAN SPLIT BILL ──
function renderFriendsPicker() {
  const wrap = document.getElementById('friends-chip-list');
  if (!wrap) return;
  if (!S.friends.length) {
    wrap.innerHTML = `
      <div class="w-full p-3 rounded-xl bg-zinc-100 text-xs font-bold text-zinc-600 flex items-center justify-between">
        <span>Belum ada teman aktif.</span>
        <a href="https://keloladuit.my.id/chat" target="_top" class="px-2.5 py-1 rounded-lg bg-zinc-900 text-white text-[10px] font-black" style="text-decoration:none">+ Tambah Teman</a>
      </div>
    `;
    return;
  }

  wrap.innerHTML = S.friends.map(f => {
    const uLow = String(f.friendUsername || '').toLowerCase();
    const isSel = Boolean(S.selectedFriends[uLow]);
    const safeU = String(f.friendUsername || '').replace(/'/g, "\\'");
    const safeName = String(f.friendNamaLengkap || f.friendUsername).replace(/</g, '&lt;').replace(/>/g, '&gt;');
    return `
      <button type="button" onclick="toggleFriend('${safeU}')"
        class="px-3 py-1.5 rounded-full text-xs font-extrabold border transition ${isSel ? 'bg-zinc-900 text-white border-zinc-900' : 'bg-white text-zinc-800 border-zinc-200 hover:border-zinc-900'}">
